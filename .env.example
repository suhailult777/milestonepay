# sample = labelled simulated PayPal + fixture AI, no network. live = PayPal SANDBOX only.
MP_MODE=sample
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_EMAIL=
# AI: sample, ollama, openrouter, or auto (OpenRouter primary, Ollama fallback).
LLM_PROVIDER=sample
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b-instruct
# OpenRouter key and preset are read at runtime from a file outside the repo.
# Default: ~/milestonepay_secrets/.env.openrouter
# OPENROUTER_ENV_FILE=
# Optional overrides. The external file normally sets OPENROUTER_API_KEY, OPENROUTER_PRESET, OPENROUTER_FALLBACKS.
# OPENROUTER_MODEL=
# OPENROUTER_PRESET=
# OPENROUTER_FALLBACKS=
# OPENROUTER_TIMEOUT=45
MP_DB=milestonepay.sqlite3
MP_ADMIN_TOKEN=
MP_API_PORT=8000
MP_WEB_PORT=5173
